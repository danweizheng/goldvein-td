{
  "name": "goldvein-td",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "《窃金者 TD》—— 以窃取敌人钱包为核心经济引擎的单机离线网页塔防",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
