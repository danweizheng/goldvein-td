{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RelicDef",
  "description": "圣物（策划案 §4.7.2）。crystalCostPerLevel 长度必须 == maxLevel。解锁类圣物用 unlocksUnit。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "maxLevel",
    "effectPerLevel",
    "effectUnit",
    "crystalCostPerLevel",
    "description"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 32 },
    "name": { "type": "string", "minLength": 1, "maxLength": 24 },
    "maxLevel": { "type": "integer", "minimum": 1, "maximum": 10 },
    "effectPerLevel": { "type": "integer", "minimum": 0, "maximum": 100000000 },
    "effectUnit": {
      "description": "★ 对契约 14.1 的可选扩展（超集）：effectPerLevel 的单位。permille = 千分比；fixed = 定点数值（金币/木材/秒）；count = 纯计数。",
      "enum": ["permille", "fixed", "count"]
    },
    "crystalCostPerLevel": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "integer", "minimum": 0 },
      "description": "每级价格（暗金结晶，纯计数，非定点），长度必须 == maxLevel"
    },
    "unlocksUnit": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "解锁类圣物：解锁的 unit id，必须存在于 units.json"
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 200 }
  }
}
