{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnitDef",
  "description": "塔/单位定义（策划案 §4.2）。所有数值字段遵循接口契约 §2/§3.2 定点约定（×1000）；纯计数字段（tier / block）用普通整数。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "line",
    "tier",
    "cost",
    "attack",
    "attackInterval",
    "range",
    "attackType",
    "stealBase",
    "critRate",
    "critMul",
    "block",
    "slowWhileBlocked",
    "sellsFor",
    "icon",
    "sprite",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 32,
      "description": "唯一 id（snake_case）。被 waves/enemies/relics/equipment 引用。"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 24 },
    "line": {
      "description": "单位系。本期可用 9 值：6 大战斗塔系（thief/archer/mage/drill/beauty/cannon）+ 3 个经济/功能系（worker 工人 / sprite 小精灵 / tech 科技塔）。hero 为 M6 保留成员（§14.1 冻结值），本期 units.json 不得出现。",
      "enum": ["thief", "archer", "mage", "drill", "beauty", "cannon", "worker", "sprite", "tech", "hero"]
    },
    "tier": {
      "description": "等级。T2 分支（军训系）两条分支同为 2。",
      "enum": [1, 2, 3, 4, 5]
    },
    "cost": { "$ref": "#/definitions/Cost" },
    "attack": {
      "type": "integer",
      "minimum": 0,
      "description": "定点。策划案 8 → 8000"
    },
    "attackInterval": {
      "type": "integer",
      "minimum": 1,
      "description": "★ 间隔秒，定点。不是频率。策划案 1.0/s → 1000；1.2/s → 833；0.6/s → 1667（round(1000/频率)）"
    },
    "range": {
      "type": "integer",
      "minimum": 0,
      "description": "格，定点。2.0 格 → 2000"
    },
    "attackType": { "$ref": "#/definitions/AttackType" },
    "stealBase": {
      "type": "integer",
      "minimum": 0,
      "description": "窃金基础系数，定点。0 = 非经济塔"
    },
    "critRate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "description": "窃金暴击率，千分比。50 = 5%"
    },
    "critMul": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 10000,
      "description": "窃金暴击倍率，千分比。1500 = ×1.5"
    },
    "auras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/definitions/Aura" },
      "description": "光环列表（同级不叠加，取最高）。★ 主策划裁决：契约 §14.1 的单对象 `aura` **已弃用并从此 Schema 删除**——两者并存会让「引擎读 aura、数据写 auras」变成静默失效且无报错。多效果单位（法师爷爷 +15%攻击/+15%攻速/+10%射程；训导主任 敌人−25%抗性 + 周围神偷系+20%窃金）一律写在 auras[] 里。"
    },
    "abilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/definitions/Ability" },
      "description": "特殊技能。params 的键名自带单位后缀（见 schema/README 约定）。"
    },
    "block": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "阻挡名额，纯计数"
    },
    "slowWhileBlocked": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "description": "被本塔阻挡时敌人额外减速，千分比。400 = −40%（列阵）"
    },
    "upgradesTo": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "description": "可升级目标 unit id。长度 >1 = 分支。必须真实存在于 units.json。"
    },
    "sellsFor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "description": "出售返还，千分比。700 = 70%"
    },
    "icon": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sprite": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "minLength": 1, "maxLength": 200 },
    "roleTag": {
      "description": "UI 定位标签（策划案 §6.1 ②）",
      "enum": ["transition", "core", "support", "blocker", "endgame"]
    }
  },
  "definitions": {
    "Cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gold", "wood"],
      "properties": {
        "gold": { "type": "integer", "minimum": 0, "description": "定点。250 金 → 250000" },
        "wood": { "type": "integer", "minimum": 0, "description": "定点。1500 木 → 1500000" }
      }
    },
    "AttackType": {
      "enum": ["normal", "pierce", "magic", "siege", "chaos"]
    },
    "AuraKind": {
      "enum": [
        "attackPct",
        "speedPct",
        "rangePct",
        "slowPct",
        "allPct",
        "stealPct",
        "stealResistDebuff"
      ]
    },
    "Aura": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "radius", "affects"],
      "properties": {
        "kind": { "$ref": "#/definitions/AuraKind" },
        "value": { "type": "integer", "minimum": 0, "maximum": 5000, "description": "千分比" },
        "radius": { "type": "integer", "minimum": 0, "description": "格，定点；0 = 全图" },
        "affects": { "enum": ["allyTower", "enemy"] }
      },
      "description": "光环。★ 主策划裁决：单对象 `aura` 已弃用，全部效果写在单位的 auras[] 列表里（避免引擎/数据字段不一致导致静默失效）。"
    },
    "AbilityId": {
      "description": "技能 id 目录。新增技能必须同时在此枚举登记 —— 这是引用完整性的校验目标。",
      "enum": [
        "stealth",
        "midas_touch",
        "relocate_free",
        "steal_ignore_counter",
        "multishot",
        "bounce",
        "archmage_range_aura",
        "phalanx",
        "chain_pull",
        "detention",
        "detention_steal_aura",
        "frost_hit",
        "group_slow",
        "group_slow_freeze",
        "splash",
        "splash_burn",
        "wood_gather",
        "build_boost",
        "tech_unlock"
      ]
    },
    "Ability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cooldown", "params"],
      "properties": {
        "id": { "$ref": "#/definitions/AbilityId" },
        "cooldown": {
          "type": "integer",
          "minimum": 0,
          "description": "秒，定点。0 = 常驻被动"
        },
        "params": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
          "additionalProperties": { "type": "integer" },
          "description": "参数表。键名后缀决定单位：…Pct=千分比；…Sec=秒(定点)；…Cells=格(定点)；无后缀=纯计数。"
        }
      }
    }
  }
}
