{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EquipmentDef",
  "description": "装备（策划案 §4.2.7，M6 上线）。⚠ 契约 14.1 未定义 EquipmentDef 手写类型，本 Schema 为 data-arch 自拟，需主策划确认。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "cost", "effects", "icon", "sprite", "description", "availableFrom"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 32 },
    "name": { "type": "string", "minLength": 1, "maxLength": 24 },
    "cost": { "$ref": "#/definitions/Cost" },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/definitions/Effect" }
    },
    "equipSlot": {
      "description": "附加可选扩展：装备栏位标签（M6 英雄 6 格）",
      "enum": ["weapon", "glove", "boots", "ring", "trinket", "tool"]
    },
    "icon": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sprite": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "minLength": 1, "maxLength": 200 },
    "availableFrom": {
      "description": "上线里程碑。本期（M0）全部为 M6，仅建表不接入模拟层。",
      "enum": ["M0", "M1", "M2", "M3", "M4", "M5", "M6"]
    }
  },
  "definitions": {
    "Cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gold", "wood"],
      "properties": {
        "gold": { "type": "integer", "minimum": 0, "description": "定点。9000 金 → 9000000" },
        "wood": { "type": "integer", "minimum": 0, "description": "定点" }
      }
    },
    "TowerLine": {
      "description": "与 units.schema.json 的 line 枚举保持一致（9 个本期可用值 + hero 为 M6 保留）",
      "enum": ["thief", "archer", "mage", "drill", "beauty", "cannon", "worker", "sprite", "tech", "hero"]
    },
    "EffectKind": {
      "enum": [
        "stealPct",
        "critRate",
        "speedPct",
        "bountyPct",
        "cooldownPct",
        "rangePct",
        "attackPct"
      ]
    },
    "Effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "$ref": "#/definitions/EffectKind" },
        "value": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 10000,
          "description": "千分比增量。stealPct +100% → 1000；cooldownPct −20% → -200；critRate +15% → 150"
        },
        "targetLine": {
          "$ref": "#/definitions/TowerLine",
          "description": "限定生效的塔系；缺省 = 全部"
        }
      }
    }
  }
}
